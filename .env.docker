# ============================================================================
# FA-Platform Docker Environment Configuration
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.docker .env
# 2. Generate SECRET_KEY: python3 -c 'import secrets; print(secrets.token_hex(32))'
# 3. Replace placeholder values below
# 4. Run: docker-compose up -d
# ============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=financial_advisor
POSTGRES_USER=fa_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_NOW
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# -----------------------------------------------------------------------------
# CRITICAL: Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_RUN_COMMAND_ABOVE

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Production (replace with your actual domains):
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEBUG=False

# -----------------------------------------------------------------------------
# Demo User Credentials
# -----------------------------------------------------------------------------
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@Pass123!

# Seed demo data on first run? (true/false)
SEED_DEMO_DATA=true

# -----------------------------------------------------------------------------
# LLM Service Configuration (Optional)
# -----------------------------------------------------------------------------
# Leave empty if not using AI features
HUGGINGFACE_API_KEY=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chromadb

# -----------------------------------------------------------------------------
# Email Configuration (Optional)
# -----------------------------------------------------------------------------
# Leave empty if not using email features
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Financial Advisor

# -----------------------------------------------------------------------------
# Scheduler Configuration (Optional)
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=False
REMINDER_AGENT_HOUR=9
REMINDER_AGENT_MINUTE=0

# ============================================================================
# DOCKER DEPLOYMENT CHECKLIST:
# ============================================================================
# Before running docker-compose up:
# [ ] Generated new SECRET_KEY (run command above)
# [ ] Changed POSTGRES_PASSWORD to something secure
# [ ] Set DEBUG=False for production
# [ ] Configured ALLOWED_ORIGINS with your domain(s)
# [ ] Changed DEMO_USER_PASSWORD
# [ ] Verified ports 3000 and 8000 are available
# ============================================================================
