# ============================================================================
# Docker Ignore File for FA-Platform Backend
# Excludes files not needed in Docker image for faster builds
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/

# Environment Files (use docker-compose environment instead)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Uploads (will be managed via volumes)
uploads/
temp/

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in runtime)
*.md
docs/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Alembic (if added later, exclude versions during build)
alembic/versions/*.pyc

# Mac
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml
