# =============================================================================
# FA-Platform Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace ALL placeholder values with your actual configuration
# 3. NEVER commit .env file to version control
# 4. Generate secure secrets: python -c 'import secrets; print(secrets.token_hex(32))'
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL (Recommended for Production):
DATABASE_URL=postgresql://username:secure_password@localhost:5432/financial_advisor

# SQLite (Development only - NOT for production):
# DATABASE_URL=sqlite:///./financial_advisor.db

# -----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# -----------------------------------------------------------------------------
# CRITICAL: Generate a secure random secret key - NEVER use a default
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_RUN_COMMAND_ABOVE

# JWT Algorithm (default: HS256 - do not change unless you know what you're doing)
ALGORITHM=HS256

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# CORS Configuration (REQUIRED for Production)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins - NEVER use wildcards (*) in production
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Production (replace with your actual domains):
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Hugging Face LLM (Free Tier)
# Sign up at https://huggingface.co/ and create an API token
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxx
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chromadb

# Email Configuration (Gmail SMTP - Free)
# 1. Enable 2-factor authentication on Gmail
# 2. Generate app password: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=Financial Advisor

# Scheduler Configuration
SCHEDULER_ENABLED=True
REMINDER_AGENT_HOUR=9
REMINDER_AGENT_MINUTE=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# SECURITY: Set DEBUG=False in production (exposes internal errors if True)
DEBUG=False

# -----------------------------------------------------------------------------
# Demo User Credentials (Optional - for seed data only)
# -----------------------------------------------------------------------------
# Change these before going to production or disable demo account entirely
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!

# =============================================================================
# PRODUCTION DEPLOYMENT SECURITY CHECKLIST:
# =============================================================================
# Before deploying to production, ensure you have:
# [ ] Generated a new SECRET_KEY (run the python command above)
# [ ] Changed DATABASE_URL with a secure password
# [ ] Set DEBUG=False
# [ ] Configured ALLOWED_ORIGINS with your actual domain(s) - NO wildcards
# [ ] Changed or disabled DEMO_USER_PASSWORD
# [ ] Rotated all API keys (HUGGINGFACE_API_KEY, EMAIL credentials, etc.)
# [ ] Verified that .env is listed in .gitignore
# [ ] Set up database backups and disaster recovery
# [ ] Configured HTTPS/TLS for your API server
# [ ] Set up application monitoring and logging
# [ ] Implemented rate limiting at infrastructure level
# [ ] Reviewed and tested all security configurations
# =============================================================================
